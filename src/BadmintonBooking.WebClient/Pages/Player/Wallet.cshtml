@page
@{
    ViewData["Title"] = "Ví CourtSide & Tài khoản";
}

<div class="max-w-7xl mx-auto px-6 py-10 space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
        <div>
            <h1 class="text-3xl font-black text-slate-800">Ví CourtSide & Tài khoản</h1>
            <p class="text-xs text-slate-500 mt-1">Quản lý số dư đặt sân, điểm thưởng thành viên và lịch sử giao dịch</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Tài khoản đã xác thực
            </span>
        </div>
    </div>

    <!-- Top Cards: Digital Wallet & Member Tier -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <!-- Digital Wallet Card (Teal Theme) -->
        <div class="lg:col-span-7 bg-gradient-to-br from-[#004d46] via-[#00685f] to-[#008378] text-white p-8 rounded-3xl shadow-xl shadow-[#00685f]/20 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

            <div>
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[28px] text-[#6df5e1]">sports_tennis</span>
                        <span class="font-black text-xl tracking-tight">CourtSide Wallet</span>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/20 backdrop-blur-md">Escrow Protected</span>
                </div>

                <span class="text-xs text-emerald-100/80 font-medium block">Số dư khả dụng</span>
                <div class="text-3xl sm:text-4xl font-black text-white mt-1">1.250.000đ</div>
            </div>

            <div class="pt-8 flex flex-wrap items-center gap-3">
                <button onclick="Swal.fire({icon: 'info', title: 'Nạp tiền', text: 'Chuyển khoản qua VietQR hoặc Napas để nạp tiền vào ví.', confirmButtonColor: '#00685f'})"
                        class="bg-white hover:bg-slate-100 text-[#00685f] px-5 py-2.5 rounded-xl font-bold text-xs shadow-md transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Nạp tiền</span>
                </button>

                <button onclick="Swal.fire({icon: 'info', title: 'Rút tiền', text: 'Số dư ví sẽ được chuyển về tài khoản ngân hàng chính chủ trong 24h.', confirmButtonColor: '#00685f'})"
                        class="bg-white/15 hover:bg-white/25 text-white px-5 py-2.5 rounded-xl font-bold text-xs border border-white/20 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">account_balance</span>
                    <span>Rút về ngân hàng</span>
                </button>
            </div>
        </div>

        <!-- Membership Tier Card -->
        <div class="lg:col-span-5 bg-white p-8 rounded-3xl shadow-sm border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Hạng thành viên</span>
                    <span class="bg-amber-100 text-amber-800 text-xs font-extrabold px-3 py-1 rounded-full flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">stars</span>
                        <span>Gold Member</span>
                    </span>
                </div>
                <h3 class="text-xl font-black text-slate-800" id="walletUserName">Nguyễn Văn Hoàng</h3>
                <p class="text-xs text-slate-500 mt-1">Tích lũy: <strong class="text-[#00685f]">2,480 điểm</strong> (Còn 520 điểm để lên Platinum)</p>
            </div>

            <div class="pt-6 border-t border-slate-100 space-y-2 text-xs text-slate-600">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>Giảm 5% toàn bộ các ca đặt sân trên toàn sàn</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>Ưu tiên giữ chỗ các khung giờ vàng 17h - 20h</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>Hoàn tiền hủy sân tức thì trong 30 giây</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction History Table -->
    <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-slate-200 space-y-4">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-black text-slate-800">Lịch sử giao dịch gần đây</h3>
                <p class="text-xs text-slate-400">Các hoạt động thanh toán và hoàn tiền qua ví</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-slate-400 font-bold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-4">Mã giao dịch</th>
                        <th class="py-3 px-4">Nội dung</th>
                        <th class="py-3 px-4">Thời gian</th>
                        <th class="py-3 px-4">Số tiền</th>
                        <th class="py-3 px-4">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50/70">
                        <td class="py-3.5 px-4 font-mono font-bold text-slate-600">#TX-9482</td>
                        <td class="py-3.5 px-4 font-bold text-slate-800">Thanh toán đặt sân Sân 2 (Sky Badminton)</td>
                        <td class="py-3.5 px-4 text-slate-400">10/11/2026 14:30</td>
                        <td class="py-3.5 px-4 font-bold text-rose-600">-140.000đ</td>
                        <td class="py-3.5 px-4"><span class="bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full text-[10px] font-bold">Thành công</span></td>
                    </tr>
                    <tr class="hover:bg-slate-50/70">
                        <td class="py-3.5 px-4 font-mono font-bold text-slate-600">#TX-9401</td>
                        <td class="py-3.5 px-4 font-bold text-slate-800">Nạp tiền từ MB Bank Napas 247</td>
                        <td class="py-3.5 px-4 text-slate-400">08/11/2026 09:15</td>
                        <td class="py-3.5 px-4 font-bold text-emerald-600">+500.000đ</td>
                        <td class="py-3.5 px-4"><span class="bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full text-[10px] font-bold">Thành công</span></td>
                    </tr>
                    <tr class="hover:bg-slate-50/70">
                        <td class="py-3.5 px-4 font-mono font-bold text-slate-600">#TX-8921</td>
                        <td class="py-3.5 px-4 font-bold text-slate-800">Hoàn tiền hủy lịch đặt sân #BK-104</td>
                        <td class="py-3.5 px-4 text-slate-400">05/11/2026 18:00</td>
                        <td class="py-3.5 px-4 font-bold text-emerald-600">+100.000đ</td>
                        <td class="py-3.5 px-4"><span class="bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full text-[10px] font-bold">Đã hoàn tiền</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (!AuthManager.requireAuth()) return;
        const user = AuthManager.getUser();
        if (user) {
            document.getElementById("walletUserName").textContent = user.fullName || user.email;
        }
    });
</script>
}

