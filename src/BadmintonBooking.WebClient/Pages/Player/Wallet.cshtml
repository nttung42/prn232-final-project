@page
@{
    ViewData["Title"] = "Ví CourtSide & Tài khoản";
}

<div class="max-w-7xl mx-auto px-6 py-10 space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
        <div>
            <h1 class="text-3xl font-black text-slate-800">Ví CourtSide & Tài khoản</h1>
            <p class="text-xs text-slate-500 mt-1">Quản lý số dư đặt sân và lịch sử giao dịch qua VietQR Napas 247</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Tài khoản đã kích hoạt ví
            </span>
        </div>
    </div>

    <!-- Top Cards: Digital Wallet & Account Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <!-- Digital Wallet Card (Teal Theme) -->
        <div class="lg:col-span-7 bg-gradient-to-br from-[#004d46] via-[#00685f] to-[#008378] text-white p-8 rounded-3xl shadow-xl shadow-[#00685f]/20 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

            <div>
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[28px] text-[#6df5e1]">sports_tennis</span>
                        <span class="font-black text-xl tracking-tight">CourtSide Wallet</span>
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/20 backdrop-blur-md">VietQR Napas 247</span>
                </div>

                <span class="text-xs text-emerald-100/80 font-medium block">Số dư khả dụng</span>
                <div class="text-3xl sm:text-4xl font-black text-white mt-1" id="walletBalance">0đ</div>
            </div>

            <div class="pt-8 flex flex-wrap items-center gap-3">
                <button onclick="openTopupModal()"
                        class="bg-white hover:bg-slate-100 text-[#00685f] px-5 py-2.5 rounded-xl font-bold text-xs shadow-md transition-all flex items-center gap-1.5 hover:scale-105">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Nạp tiền qua VietQR</span>
                </button>

            </div>
        </div>

        <!-- Account Info Card -->
        <div class="lg:col-span-5 bg-white p-8 rounded-3xl shadow-sm border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Thông tin chủ ví</span>
                    <span class="bg-emerald-50 text-emerald-700 text-xs font-extrabold px-3 py-1 rounded-full flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">verified_user</span>
                        <span>Đã xác minh</span>
                    </span>
                </div>
                <h3 class="text-xl font-black text-slate-800" id="walletUserName">...</h3>
                <p class="text-xs text-slate-500 mt-1" id="walletUserEmail">...</p>
            </div>

            <div class="pt-6 border-t border-slate-100 space-y-2.5 text-xs text-slate-600">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>Thanh toán 1 chạm tức thì không cần nhập thẻ</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>Bảo vệ quyền lợi đặt sân với chính sách hoàn tiền tự động</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
                    <span>Nạp tiền qua chuyển khoản VietQR (Napas 247)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction History Table -->
    <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-slate-200 space-y-4">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-black text-slate-800">Lịch sử giao dịch ví</h3>
                <p class="text-xs text-slate-400">Các hoạt động nạp tiền, thanh toán và hoàn tiền qua ví</p>
            </div>
            <button onclick="loadWalletData()" class="text-xs font-bold text-[#00685f] hover:underline flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">refresh</span>
                <span>Làm mới</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-slate-400 font-bold uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-4">Mã tham chiếu</th>
                        <th class="py-3 px-4">Nội dung giao dịch</th>
                        <th class="py-3 px-4">Loại GD</th>
                        <th class="py-3 px-4">Thời gian</th>
                        <th class="py-3 px-4">Số tiền</th>
                        <th class="py-3 px-4 text-right">Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="txTbody" class="divide-y divide-slate-100">
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400">
                            <div class="inline-block animate-spin rounded-full h-5 w-5 border-2 border-[#00685f] border-t-transparent"></div>
                            <p class="mt-2 text-xs">Đang tải lịch sử giao dịch...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nạp Tiền VietQR -->
<div id="topupModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl border border-slate-100 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-slate-800">Nạp tiền vào Ví CourtSide</h3>
            <button onclick="closeTopupModal()" class="text-slate-400 hover:text-slate-600">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Step 1: Input Amount -->
        <div id="topupStep1" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Nhập số tiền nạp (VNĐ)</label>
                <input type="number" id="topupAmountInput" min="10000" step="10000" value="100000"
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-base font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
            </div>

            <!-- Quick Amount Pills -->
            <div class="grid grid-cols-3 gap-2">
                <button type="button" onclick="setTopupAmount(50000)" class="py-2 rounded-xl bg-slate-50 hover:bg-slate-100 text-xs font-bold text-slate-700 border border-slate-200">50.000đ</button>
                <button type="button" onclick="setTopupAmount(100000)" class="py-2 rounded-xl bg-slate-50 hover:bg-slate-100 text-xs font-bold text-slate-700 border border-slate-200">100.000đ</button>
                <button type="button" onclick="setTopupAmount(200000)" class="py-2 rounded-xl bg-slate-50 hover:bg-slate-100 text-xs font-bold text-slate-700 border border-slate-200">200.000đ</button>
            </div>

            <button type="button" onclick="generateTopupQr()" id="btnGenQr"
                    class="w-full py-3.5 rounded-xl bg-[#00685f] hover:bg-[#008378] text-white font-bold text-xs tracking-wide shadow-md transition-all flex items-center justify-center gap-1.5">
                <span>Tạo mã chuyển khoản VietQR</span>
                <span class="material-symbols-outlined text-[16px]">qr_code</span>
            </button>
        </div>

        <!-- Step 2: Show VietQR Image -->
        <div id="topupStep2" class="hidden space-y-4 text-center">
            <div class="w-52 h-52 mx-auto bg-white p-2 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center">
                <img id="qrDisplayImg" src="" class="w-full h-full object-contain" alt="VietQR Nạp tiền" />
            </div>

            <div class="text-xs text-slate-600 bg-slate-50 p-3.5 rounded-2xl space-y-1 text-left">
                <div class="flex justify-between"><span class="text-slate-400">Ngân hàng:</span><span class="font-bold text-slate-800" id="qrBankName">MB Bank</span></div>
                <div class="flex justify-between"><span class="text-slate-400">Số tài khoản:</span><span class="font-bold text-slate-800" id="qrAccountNo">999988887777</span></div>
                <div class="flex justify-between"><span class="text-slate-400">Số tiền:</span><span class="font-bold text-[#00685f]" id="qrAmount">0đ</span></div>
                <div class="flex justify-between"><span class="text-slate-400">Nội dung CK:</span><span class="font-mono font-bold text-slate-800" id="qrContent">...</span></div>
            </div>

            <div class="pt-2 text-center">
                <p id="topupStatus" class="text-xs text-slate-500">
                    Admin sẽ xác nhận sau khi nhận được tiền. Trang này sẽ tự cập nhật khi được xác nhận.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentTopupTxId = null;
    let currentTopupCode = null;
    let topupPollTimer = null;

    async function loadWalletData() {
        if (!AuthManager.requireAuth()) return;

        try {
            const wallet = await callApi("/api/wallet/me");
            document.getElementById("walletBalance").textContent = formatCurrency(wallet.balance);
            document.getElementById("walletUserName").textContent = wallet.fullName || "Người dùng CourtSide";
            document.getElementById("walletUserEmail").textContent = wallet.email || "";

            const transactions = await callApi("/api/wallet/transactions");
            renderTransactions(transactions);
        } catch (err) {
            console.error("Lỗi ví:", err);
        }
    }

    function renderTransactions(txList) {
        const tbody = document.getElementById("txTbody");
        if (!txList || txList.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400 text-xs">Chưa có giao dịch nào trong ví.</td></tr>`;
            return;
        }

        tbody.innerHTML = txList.map(t => {
            const isPlus = (t.transactionType === "Deposit" || t.transactionType === "BookingRefund");
            const amountColor = isPlus ? "text-emerald-600" : "text-rose-600";
            const sign = isPlus ? "+" : "-";

            let statusBadge = "";
            if (t.status === "Completed") statusBadge = `<span class="bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full text-[10px] font-bold">Thành công</span>`;
            else if (t.status === "Pending") statusBadge = `<span class="bg-amber-50 text-amber-700 px-2.5 py-1 rounded-full text-[10px] font-bold">Chờ xử lý</span>`;
            else statusBadge = `<span class="bg-rose-50 text-rose-700 px-2.5 py-1 rounded-full text-[10px] font-bold">${t.status}</span>`;

            return `
                <tr class="hover:bg-slate-50/70 transition-colors">
                    <td class="py-3 px-4 font-mono font-bold text-slate-600">#${escapeHtml(t.referenceCode || t.id)}</td>
                    <td class="py-3 px-4 font-semibold text-slate-800">${escapeHtml(t.description || "Giao dịch ví")}</td>
                    <td class="py-3 px-4 text-slate-500">${t.transactionType}</td>
                    <td class="py-3 px-4 text-slate-400">${formatDate(t.createdAt)}</td>
                    <td class="py-3 px-4 font-black ${amountColor}">${sign}${formatCurrency(t.amount)}</td>
                    <td class="py-3 px-4 text-right">${statusBadge}</td>
                </tr>
            `;
        }).join("");
    }

    function openTopupModal() {
        document.getElementById("topupStep1").classList.remove("hidden");
        document.getElementById("topupStep2").classList.add("hidden");
        document.getElementById("topupModal").classList.remove("hidden");
        document.getElementById("topupModal").classList.add("flex");
    }

    function closeTopupModal() {
        stopTopupPolling();
        document.getElementById("topupModal").classList.add("hidden");
        document.getElementById("topupModal").classList.remove("flex");
    }

    function setTopupAmount(amt) {
        document.getElementById("topupAmountInput").value = amt;
    }

    async function generateTopupQr() {
        const amount = parseFloat(document.getElementById("topupAmountInput").value);
        if (isNaN(amount) || amount < 10000) {
            Swal.fire({ icon: "warning", title: "Số tiền không hợp lệ", text: "Số tiền nạp tối thiểu là 10.000đ", confirmButtonColor: "#00685f" });
            return;
        }

        const btn = document.getElementById("btnGenQr");
        btn.disabled = true;

        try {
            const res = await callApi("/api/wallet/topup", {
                method: "POST",
                data: { amount }
            });

            currentTopupTxId = res.transactionId;
            currentTopupCode = res.referenceCode;
            startTopupPolling();
            document.getElementById("qrDisplayImg").src = res.qrUrl;
            document.getElementById("qrBankName").textContent = res.bankName;
            document.getElementById("qrAccountNo").textContent = res.accountNo;
            document.getElementById("qrAmount").textContent = formatCurrency(res.amount);
            document.getElementById("qrContent").textContent = res.transferContent;

            document.getElementById("topupStep1").classList.add("hidden");
            document.getElementById("topupStep2").classList.remove("hidden");
        } catch (err) {
            Swal.fire({ icon: "error", title: "Lỗi", text: err.message, confirmButtonColor: "#00685f" });
        } finally {
            btn.disabled = false;
        }
    }

    // Hỏi trạng thái yêu cầu nạp mỗi 3 giây. Server tự cộng ví khi webhook SePay khớp mã.
    function startTopupPolling() {
        stopTopupPolling();
        topupPollTimer = setInterval(checkTopupStatus, 3000);
    }

    function stopTopupPolling() {
        if (topupPollTimer) clearInterval(topupPollTimer);
        topupPollTimer = null;
    }

    async function checkTopupStatus() {
        if (!currentTopupCode) return;
        try {
            const status = await callApi(`/api/payments/${encodeURIComponent(currentTopupCode)}/status`);
            if (status.status === "Paid") {
                stopTopupPolling();
                Swal.fire({
                    icon: "success",
                    title: "Nạp tiền thành công!",
                    text: `Đã cộng ${formatCurrency(status.amount)} vào ví.`,
                    confirmButtonColor: "#00685f"
                });
                closeTopupModal();
                loadWalletData();
            } else if (status.status === "Expired") {
                stopTopupPolling();
                document.getElementById("topupStatus").textContent = "Yêu cầu nạp đã hết hạn. Vui lòng tạo mã mới.";
            }
        } catch (err) {
            // Lỗi mạng tạm thời: thử lại ở lần kiểm tra sau
        }
    }

    document.addEventListener("DOMContentLoaded", loadWalletData);
</script>
}
