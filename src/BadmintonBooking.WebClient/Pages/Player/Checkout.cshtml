@page
@{
    ViewData["Title"] = "Thanh toán & Xác nhận Đặt sân";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <!-- Stepper Header -->
    <div class="flex items-center justify-center mb-10">
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 text-emerald-700 font-bold text-xs">
                <span class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center material-symbols-outlined text-sm">check</span>
                <span>1. Chọn sân</span>
            </div>
            <div class="w-12 h-0.5 bg-emerald-200"></div>
            <div class="flex items-center gap-2 text-[#06525c] font-bold text-xs">
                <span class="w-7 h-7 rounded-full bg-[#06525c] text-white flex items-center justify-center text-xs">2</span>
                <span>2. Thanh toán & Xác nhận</span>
            </div>
            <div class="w-12 h-0.5 bg-slate-200"></div>
            <div class="flex items-center gap-2 text-slate-400 font-medium text-xs">
                <span class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-xs">3</span>
                <span>3. Hoàn tất</span>
            </div>
        </div>
    </div>

    <!-- 2-Column Checkout Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Column: Details & Payment Methods -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Booking Details Card -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                    <h2 class="text-base font-black text-slate-800">Thông tin Đơn đặt sân</h2>
                    <span class="bg-emerald-50 text-emerald-700 text-[10px] font-bold px-2.5 py-1 rounded-full">Chờ xác nhận</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div>
                        <span class="text-slate-400 block mb-0.5">Cụm sân:</span>
                        <span class="font-bold text-slate-800 text-sm" id="checkoutFacility">Sky Badminton</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Sân thi đấu:</span>
                        <span class="font-bold text-slate-800 text-sm" id="checkoutCourt">Sân 1</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Khung giờ:</span>
                        <span class="font-bold text-slate-800 text-sm" id="checkoutSlot">17:00 - 18:00</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Ngày chơi:</span>
                        <span class="font-bold text-slate-800 text-sm" id="checkoutDate">2026-11-10</span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Ghi chú cho chủ sân</label>
                    <textarea id="checkoutNote" rows="2" placeholder="Ví dụ: Đặt thêm 2 chai nước khoáng, yêu cầu bật máy lạnh sớm..."
                              class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#06525c]"></textarea>
                </div>
            </div>

            <!-- Payment Methods -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 space-y-4">
                <h2 class="text-base font-black text-slate-800">Phương thức thanh toán</h2>
                
                <div class="space-y-3">
                    <label class="flex items-center justify-between p-4 rounded-2xl border-2 border-[#06525c] bg-[#06525c]/5 cursor-pointer">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[#06525c] text-[24px]">qr_code_2</span>
                            <div>
                                <span class="font-bold text-xs text-slate-800 block">Chuyển khoản VietQR / Napas 247</span>
                                <span class="text-[10px] text-slate-500">Chủ sân xác nhận sau khi nhận tiền</span>
                            </div>
                        </div>
                        <input type="radio" name="payMethod" value="QR" checked class="text-[#06525c]" />
                    </label>

                    <label class="flex items-center justify-between p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-300 cursor-pointer transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[#06525c] text-[24px]">account_balance_wallet</span>
                            <div>
                                <span class="font-bold text-xs text-slate-800 block">Ví CourtSide (Số dư: <span id="walletBalanceText">đang tải...</span>)</span>
                                <span class="text-[10px] text-slate-500 font-semibold">Trừ trực tiếp từ số dư ví, đơn được xác nhận ngay</span>
                            </div>
                        </div>
                        <input type="radio" name="payMethod" value="Wallet" class="text-[#06525c]" />
                    </label>

                    <label class="flex items-center justify-between p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-300 cursor-pointer transition-colors">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-slate-500 text-[24px]">payments</span>
                            <div>
                                <span class="font-bold text-xs text-slate-800 block">Thanh toán tại quầy sân</span>
                                <span class="text-[10px] text-slate-500">Thanh toán tiền mặt hoặc quẹt thẻ khi đến nhận sân</span>
                            </div>
                        </div>
                        <input type="radio" name="payMethod" value="Cash" class="text-[#06525c]" />
                    </label>
                </div>
            </div>
        </div>

        <!-- Right Column: Order Summary & Instant QR -->
        <div class="lg:col-span-5 space-y-6">
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 space-y-5">
                <h3 class="text-base font-black text-slate-800">Tóm tắt thanh toán</h3>

                <div class="space-y-2.5 text-xs text-slate-600">
                    <div class="flex items-center justify-between">
                        <span>Giá thuê sân (1 ca):</span>
                        <span class="font-bold text-slate-800" id="summaryBasePrice">0đ</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span>Phí dịch vụ nền tảng:</span>
                        <span class="text-emerald-600 font-bold">Miễn phí (0đ)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span>Giảm giá khuyến mãi:</span>
                        <span class="text-slate-400">0đ</span>
                    </div>
                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-800">Tổng thanh toán:</span>
                        <span class="text-2xl font-black text-[#06525c]" id="summaryTotalPrice">0đ</span>
                    </div>
                </div>

                <!-- VietQR Box -->
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 flex flex-col items-center text-center">
                    <span class="text-[10px] font-bold uppercase text-slate-400 mb-2 tracking-wider">Quét mã chuyển khoản tức thì</span>
                    <div class="w-44 h-44 bg-white p-2 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center">
                        <!-- Mã QR thật chỉ hiện sau khi tạo đơn (xem showBankPaymentAndWait) -->
                        <div id="vietqrPlaceholder" class="text-center text-[11px] text-slate-400 px-2">
                            <span class="material-symbols-outlined text-3xl text-slate-300">qr_code_2</span>
                            <p class="mt-1">Nhấn xác nhận để tạo mã QR</p>
                        </div>
                        <img id="vietqrImg" src="" alt="Mã QR chuyển khoản" class="hidden w-full h-full object-contain" />
                    </div>
                    <div class="mt-3 text-[11px] text-slate-600">
                        <p class="font-bold text-slate-800">MB BANK: 999988887777</p>
                        <p class="text-slate-500">Chủ TK: CTY CP COURTSIDE VIETNAM</p>
                        <p class="text-[10px] text-[#06525c] font-mono mt-1 font-bold">Nội dung: <span id="refCode">sẽ hiển thị sau khi tạo đơn</span></p>
                    </div>
                    <div class="mt-3 text-[10px] text-rose-500 font-semibold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">timer</span>
                        <span>Vui lòng hoàn tất trong: <strong id="countdown">09:59</strong></span>
                    </div>
                </div>

                <button onclick="confirmBooking()" id="btnConfirmBooking"
                        class="w-full py-4 rounded-xl bg-[#06525c] hover:bg-[#053f47] text-white font-bold text-sm tracking-wide shadow-sm transition-all hover:scale-[1.02] flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">check_circle</span>
                    <span>Xác nhận & Hoàn tất Đặt sân</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const params = new URLSearchParams(window.location.search);
    const facilityId = params.get("facilityId");
    const courtId = params.get("courtId");
    const slotId = params.get("slotId");
    const playDate = params.get("playDate");
    const facilityName = params.get("facilityName");
    const courtName = params.get("courtName");
    const slotName = params.get("slotName");
    const price = parseFloat(params.get("price") || 0);

    document.addEventListener("DOMContentLoaded", function () {
        if (!AuthManager.requireAuth()) return;

        // Chỉ người chơi mới đặt sân (API tạo đơn chỉ cho Player/Admin). Chặn sớm để không lỗi sau khi bấm.
        const currentUser = AuthManager.getUser();
        if (currentUser && currentUser.role !== "Player") {
            const confirmBtn = document.getElementById("btnConfirmBooking");
            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.onclick = null;
                confirmBtn.classList.add("opacity-50", "cursor-not-allowed");
            }
            Swal.fire({
                icon: "info",
                title: "Chỉ người chơi mới đặt được sân",
                text: "Bạn đang đăng nhập với vai trò chủ sân. Hãy đăng nhập bằng tài khoản người chơi để đặt sân.",
                confirmButtonColor: "#06525c"
            });
        }

        if (!courtId || !slotId) {
            alert("Thông tin đặt sân không hợp lệ!");
            window.location.href = "/Player/Facilities";
            return;
        }

        document.getElementById("checkoutFacility").textContent = facilityName || "Cụm sân";
        document.getElementById("checkoutCourt").textContent = courtName || "Sân con";
        document.getElementById("checkoutSlot").textContent = slotName || "";
        document.getElementById("checkoutDate").textContent = formatDate(playDate);
        document.getElementById("summaryBasePrice").textContent = formatCurrency(price);
        document.getElementById("summaryTotalPrice").textContent = formatCurrency(price);

        // Số dư ví thật của người chơi
        loadWalletBalance();

        // Mã chuyển khoản chỉ được tạo từ server sau khi đặt đơn (xem confirmBooking)
        document.getElementById("refCode").textContent = "sẽ hiển thị sau khi tạo đơn";
        document.getElementById("vietqrImg").classList.add("hidden");
        document.getElementById("vietqrImg").removeAttribute("src");
        document.getElementById("vietqrPlaceholder").classList.remove("hidden");

        // Countdown timer 10 phút
        let timeLeft = 600;
        const countdownEl = document.getElementById("countdown");
        const timer = setInterval(() => {
            timeLeft--;
            const mins = String(Math.floor(timeLeft / 60)).padStart(2, "0");
            const secs = String(timeLeft % 60).padStart(2, "0");
            countdownEl.textContent = `${mins}:${secs}`;
            if (timeLeft <= 0) {
                clearInterval(timer);
                Swal.fire({
                    icon: "warning",
                    title: "Hết thời gian giữ chỗ",
                    text: "Vui lòng chọn lại sân để tiếp tục.",
                    confirmButtonColor: "#06525c"
                }).then(() => {
                    window.location.href = `/Player/FacilityDetail?id=${facilityId}`;
                });
            }
        }, 1000);
    });

    let walletBalance = null;

    // Hiển thị mã và QR chuyển khoản của đơn, rồi chờ server xác nhận (webhook SePay).
    function showBankPaymentAndWait(pay, bookingId) {
        document.getElementById("refCode").textContent = pay.code;
        document.getElementById("vietqrImg").src = pay.qrUrl;
        document.getElementById("vietqrImg").classList.remove("hidden");
        document.getElementById("vietqrPlaceholder").classList.add("hidden");
        let timer = null;
        let finished = false;
        const stop = () => { if (timer) clearInterval(timer); timer = null; };

        const check = async () => {
            try {
                const status = await callApi(`/api/payments/${encodeURIComponent(pay.code)}/status`);
                if (status.status === "Paid") {
                    finished = true;
                    stop();
                    Swal.close();
                    Swal.fire({
                        icon: "success",
                        title: "Đặt sân thành công!",
                        text: `Đã nhận thanh toán. Mã đơn #BK-${bookingId} đã được xác nhận.`,
                        confirmButtonColor: "#06525c"
                    }).then(() => { window.location.href = "/Player/MyBookings"; });
                } else if (status.status === "Expired") {
                    finished = true;
                    stop();
                    Swal.close();
                    Swal.fire({
                        icon: "warning",
                        title: "Hết thời gian thanh toán",
                        text: "Đơn đã bị hủy do chưa nhận được tiền. Vui lòng đặt lại.",
                        confirmButtonColor: "#06525c"
                    }).then(() => { window.location.href = "/Player/MyBookings"; });
                }
            } catch (e) { /* lỗi mạng tạm thời: thử lại */ }
        };

        Swal.fire({
            title: "Chuyển khoản để xác nhận đơn",
            html: `
                <img src="${pay.qrUrl}" alt="QR chuyển khoản" style="width:220px;height:220px;margin:0 auto 12px;">
                <div style="text-align:left;font-size:13px;line-height:1.7">
                    <div>Ngân hàng: <b>${pay.bankId}</b></div>
                    <div>Số tài khoản: <b>${pay.accountNo}</b></div>
                    <div>Số tiền: <b>${new Intl.NumberFormat("vi-VN").format(pay.amount)}đ</b></div>
                    <div>Nội dung (bắt buộc): <b style="font-family:monospace">${pay.transferContent}</b></div>
                </div>
                <p style="margin-top:10px;font-size:12px;color:#64748b">Chủ sân sẽ xác nhận đơn sau khi nhận được tiền. Trang này sẽ tự cập nhật.</p>`,
            showConfirmButton: false,
            showCloseButton: true,
            allowOutsideClick: false,
            didOpen: () => { timer = setInterval(check, 3000); },
            willClose: () => stop()
        }).then(r => {
            if (!finished && r.dismiss === Swal.DismissReason.close) window.location.href = "/Player/MyBookings";
        });
    }

    async function loadWalletBalance() {
        try {
            const wallet = await callApi("/api/wallet/me");
            walletBalance = Number(wallet.balance);
            document.getElementById("walletBalanceText").textContent = formatCurrency(walletBalance);
        } catch (e) {
            document.getElementById("walletBalanceText").textContent = "không tải được";
        }
    }

    async function confirmBooking() {
        const method = document.querySelector('input[name="payMethod"]:checked').value;

        if (method === "Wallet" && walletBalance !== null && walletBalance < price) {
            Swal.fire({
                icon: "warning",
                title: "Số dư ví không đủ",
                text: `Số dư hiện có ${formatCurrency(walletBalance)}, cần ${formatCurrency(price)}. Vui lòng nạp thêm hoặc chọn phương thức khác.`,
                confirmButtonColor: "#06525c"
            });
            return;
        }

        const btn = document.getElementById("btnConfirmBooking");
        btn.disabled = true;
        btn.innerHTML = `
            <div class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
            <span>Đang ghi nhận đơn...</span>
        `;

        try {
            const bookingPayload = {
                courtId: parseInt(courtId),
                timeSlotId: parseInt(slotId),
                playDate: playDate,
                note: document.getElementById("checkoutNote").value.trim() || "Đặt sân trên CourtSide"
            };

            // API trả về ApiResponse { success, message, data }
            const res = (await callApi("/api/bookings", {
                method: "POST",
                data: bookingPayload
            })).data;

            // Chuyển khoản QR: server tạo mã thanh toán riêng cho đơn; đơn xác nhận khi webhook khớp mã
            if (method === "QR") {
                const pay = await callApi(`/api/payments/booking/${res.id}`, { method: "POST" });
                showBankPaymentAndWait(pay, res.id); // nút giữ khóa để không tạo đơn trùng
                return;
            }

            // Thanh toán bằng ví: trừ tiền ngay, đơn được xác nhận
            if (method === "Wallet") {
                try {
                    await callApi("/api/wallet/pay-booking", {
                        method: "POST",
                        data: { bookingId: res.id }
                    });
                    Swal.fire({
                        icon: "success",
                        title: "Đã trừ ví, chờ xác nhận",
                        text: `Mã đơn: #BK-${res.id}. Đã giữ tiền trong ví; chủ sân sẽ xác nhận đơn. Nếu bị từ chối, tiền sẽ hoàn về ví.`,
                        confirmButtonColor: "#06525c"
                    }).then(() => { window.location.href = "/Player/MyBookings"; });
                } catch (payErr) {
                    Swal.fire({
                        icon: "warning",
                        title: "Đơn đã tạo nhưng chưa thanh toán",
                        text: `${payErr.message}. Đơn #BK-${res.id} đang chờ thanh toán trong "Lịch đặt của tôi".`,
                        confirmButtonColor: "#06525c"
                    }).then(() => { window.location.href = "/Player/MyBookings"; });
                }
                return;
            }

            Swal.fire({
                icon: "success",
                title: "Đặt sân thành công!",
                text: `Mã đơn đặt: #BK-${res.id}. Trạng thái: ${res.status}. Vui lòng chuyển khoản hoặc thanh toán tại quầy để chủ sân xác nhận.`,
                confirmButtonColor: "#06525c"
            }).then(() => {
                window.location.href = "/Player/MyBookings";
            });

        } catch (err) {
            Swal.fire({
                icon: "error",
                title: "Đặt sân không thành công",
                text: err.message === "Forbidden"
                    ? "Tài khoản này không có quyền đặt sân. Hãy đăng nhập bằng tài khoản người chơi."
                    : (err.message || "Ca giờ có thể vừa bị người khác đặt."),
                confirmButtonColor: "#06525c"
            });
            btn.disabled = false;
            btn.innerHTML = `<span class="material-symbols-outlined text-lg">check_circle</span><span>Xác nhận & Hoàn tất Đặt sân</span>`;
        }
    }
</script>
}

