@page
@{
    ViewData["Title"] = "Đăng nhập & Đăng ký tài khoản";
}

<div class="flex w-full min-h-[calc(100vh-80px)] -mt-4">
    <!-- LEFT SIDE: CINEMATIC ATHLETIC BRANDING VISUAL (50% Desktop) -->
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-[#00201d] flex-col justify-between p-12 xl:p-16 text-white">
        <div class="absolute inset-0 bg-cover bg-center opacity-30" 
             style="background-image: url('https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?q=80&w=1200&auto=format&fit=crop')"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#00201d]/95 via-[#004d46]/85 to-[#00685f]/75 mix-blend-multiply"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-emerald-400/10 blur-3xl pointer-events-none"></div>

        <!-- Left Top Bar -->
        <div class="relative z-10 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-emerald-400 shadow-lg">
                    <span class="material-symbols-outlined text-2xl font-bold">sports_tennis</span>
                </div>
                <div>
                    <span class="text-2xl font-black tracking-tight text-white flex items-center gap-1.5">
                        CourtSide <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-400/30">PRO</span>
                    </span>
                    <span class="text-[10px] text-emerald-200/70 font-semibold tracking-wider uppercase block">Badminton Arena Platform</span>
                </div>
            </a>
            <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-100/80 hover:text-white bg-white/10 hover:bg-white/20 px-4 py-2 rounded-xl border border-white/15 transition-all">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Về trang chủ</span>
            </a>
        </div>

        <!-- Left Middle Highlights -->
        <div class="relative z-10 my-auto py-8 max-w-lg">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-md mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-300">Nền tảng cầu lông số 1 Việt Nam</span>
            </div>
            <h1 class="text-3xl xl:text-4xl font-black text-white leading-tight tracking-tight mb-4">
                Nâng tầm trận đấu cùng <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-teal-100">CourtSide</span>
            </h1>
            <p class="text-sm text-emerald-100/80 font-normal leading-relaxed mb-6">
                Giải pháp đặt sân thông minh theo thời gian thực, kết nối 150+ cụm sân chuẩn BWF và hàng chục nghìn lông thủ trên toàn quốc.
            </p>

            <div class="space-y-3">
                <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-white/[0.07] backdrop-blur-md border border-white/10">
                    <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-lg">bolt</span>
                    </div>
                    <div>
                        <h4 class="text-xs font-bold text-white">Giữ chỗ siêu tốc trong 15 giây</h4>
                        <p class="text-[11px] text-emerald-100/70 mt-0.5">Khóa slot tự động trên ma trận trực tiếp, đảm bảo không trùng giờ 100%.</p>
                    </div>
                </div>

                <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-white/[0.07] backdrop-blur-md border border-white/10">
                    <div class="w-8 h-8 rounded-xl bg-teal-400/20 text-teal-200 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
                    </div>
                    <div>
                        <h4 class="text-xs font-bold text-white">Thanh toán VietQR & Xác nhận tức thì</h4>
                        <p class="text-[11px] text-emerald-100/70 mt-0.5">Quét mã chuyển khoản bảo mật, kiểm tra đối soát tự động.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Left Bottom Proof -->
        <div class="relative z-10 pt-4 border-t border-white/15 flex items-center justify-between text-xs text-emerald-200/70">
            <span>© 2026 CourtSide Platform</span>
            <span>BWF Certified Arena Partner</span>
        </div>
    </div>

    <!-- RIGHT SIDE: AUTHENTICATION FORM CARD (50% Desktop) -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center bg-white px-6 sm:px-12 md:px-16 lg:px-12 xl:px-20 py-10">
        <div class="max-w-md w-full mx-auto">
            <!-- Welcome Header -->
            <div class="text-left mb-6">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight" id="auth-title">Chào mừng trở lại!</h2>
                <p class="text-xs text-slate-500 mt-1" id="auth-subtitle">Đăng nhập để quản lý lịch thi đấu và giữ slot yêu thích.</p>
            </div>

            <!-- Tab Switcher -->
            <div class="p-1 bg-slate-100 rounded-2xl flex items-center mb-6 border border-slate-200">
                <button type="button" id="tab-login" onclick="switchAuthTab('login')"
                        class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all bg-white text-[#00685f] shadow-sm flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-base">login</span>
                    <span>Đăng nhập</span>
                </button>
                <button type="button" id="tab-register" onclick="switchAuthTab('register')"
                        class="flex-1 py-2.5 px-4 rounded-xl text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-base">person_add</span>
                    <span>Đăng ký</span>
                </button>
            </div>

            <!-- 1. LOGIN FORM -->
            <form id="form-login" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Email <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">mail</span>
                        <input type="email" id="login-account" required placeholder="name@example.com"
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Mật khẩu <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg">lock</span>
                        <input type="password" id="login-password" required placeholder="Nhập mật khẩu"
                               class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
                        <button type="button" onclick="togglePasswordVisibility('login-password', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                            <span class="material-symbols-outlined text-lg">visibility</span>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between text-xs pt-1">
                    <label class="flex items-center gap-2 cursor-pointer text-slate-600 select-none">
                        <input type="checkbox" checked class="rounded text-[#00685f] focus:ring-[#00685f]" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="#" class="font-bold text-[#00685f] hover:underline">Quên mật khẩu?</a>
                </div>

                <button type="submit" id="btnLoginSubmit"
                        class="w-full mt-2 py-3 px-6 rounded-xl bg-[#00685f] hover:bg-[#008378] text-white font-bold text-xs tracking-wide shadow-md shadow-[#00685f]/20 transition-all flex items-center justify-center gap-2">
                    <span>Đăng nhập vào CourtSide</span>
                    <span class="material-symbols-outlined text-base">arrow_forward</span>
                </button>
            </form>

            <!-- 2. REGISTER FORM -->
            <form id="form-register" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-2">Vai trò tham gia <span class="text-rose-500">*</span></label>
                    <div class="grid grid-cols-2 gap-3">
                        <label id="role-player-card" onclick="selectRole('player')"
                               class="relative flex flex-col p-3 rounded-xl border-2 border-[#00685f] bg-[#00685f]/5 cursor-pointer transition-all">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold text-slate-800">Người chơi</span>
                                <input type="radio" name="reg_role" value="Player" checked class="text-[#00685f]" />
                            </div>
                            <span class="text-[10px] text-slate-500 leading-tight">Đặt sân & ghép kèo giao lưu</span>
                        </label>
                        <label id="role-provider-card" onclick="selectRole('provider')"
                               class="relative flex flex-col p-3 rounded-xl border-2 border-slate-200 bg-white cursor-pointer transition-all">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-bold text-slate-800">Chủ sân</span>
                                <input type="radio" name="reg_role" value="Provider" class="text-[#00685f]" />
                            </div>
                            <span class="text-[10px] text-slate-500 leading-tight">Đăng sân & quản lý lịch</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Họ và tên <span class="text-rose-500">*</span></label>
                    <input type="text" id="reg-fullname" required placeholder="Nguyễn Văn A"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Email <span class="text-rose-500">*</span></label>
                        <input type="email" id="reg-email" required placeholder="name@example.com"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Số điện thoại <span class="text-rose-500">*</span></label>
                        <input type="tel" id="reg-phone" required placeholder="0901234567" pattern="^(0[3|5|7|8|9])+[0-9]{8}$"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Mật khẩu <span class="text-rose-500">*</span></label>
                    <input type="password" id="reg-password" required placeholder="Ít nhất 6 ký tự" minlength="6"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
                </div>

                <button type="submit" id="btnRegisterSubmit"
                        class="w-full mt-2 py-3 px-6 rounded-xl bg-[#00685f] hover:bg-[#008378] text-white font-bold text-xs tracking-wide shadow-md shadow-[#00685f]/20 transition-all flex items-center justify-center gap-2">
                    <span id="btn-register-text">Tạo tài khoản Người chơi</span>
                    <span class="material-symbols-outlined text-base">arrow_forward</span>
                </button>
            </form>

            <div class="text-center mt-6 pt-5 border-t border-slate-100 text-xs text-slate-500" id="bottom-switch-text">
                Chưa có tài khoản CourtSide? 
                <button type="button" onclick="switchAuthTab('register')" class="font-bold text-[#00685f] hover:underline ml-1">Đăng ký ngay miễn phí</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function switchAuthTab(tab) {
        const loginTab = document.getElementById("tab-login");
        const regTab = document.getElementById("tab-register");
        const loginForm = document.getElementById("form-login");
        const regForm = document.getElementById("form-register");
        const title = document.getElementById("auth-title");
        const subtitle = document.getElementById("auth-subtitle");
        const bottomSwitch = document.getElementById("bottom-switch-text");

        if (tab === "login") {
            loginTab.className = "flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all bg-white text-[#00685f] shadow-sm flex items-center justify-center gap-1.5";
            regTab.className = "flex-1 py-2.5 px-4 rounded-xl text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5";
            loginForm.classList.remove("hidden");
            regForm.classList.add("hidden");
            title.textContent = "Chào mừng trở lại!";
            subtitle.textContent = "Đăng nhập để quản lý lịch thi đấu và giữ slot yêu thích.";
            bottomSwitch.innerHTML = `Chưa có tài khoản CourtSide? <button type="button" onclick="switchAuthTab('register')" class="font-bold text-[#00685f] hover:underline ml-1">Đăng ký ngay miễn phí</button>`;
        } else {
            regTab.className = "flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition-all bg-white text-[#00685f] shadow-sm flex items-center justify-center gap-1.5";
            loginTab.className = "flex-1 py-2.5 px-4 rounded-xl text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 flex items-center justify-center gap-1.5";
            loginForm.classList.add("hidden");
            regForm.classList.remove("hidden");
            title.textContent = "Tạo tài khoản CourtSide";
            subtitle.textContent = "Tham gia cộng đồng cầu lông hàng đầu và trải nghiệm thi đấu chuyên nghiệp.";
            bottomSwitch.innerHTML = `Đã có tài khoản thành viên? <button type="button" onclick="switchAuthTab('login')" class="font-bold text-[#00685f] hover:underline ml-1">Đăng nhập ngay</button>`;
        }
    }

    function selectRole(role) {
        const playerCard = document.getElementById("role-player-card");
        const providerCard = document.getElementById("role-provider-card");
        const btnText = document.getElementById("btn-register-text");

        if (role === "player") {
            playerCard.querySelector("input").checked = true;
            playerCard.className = "relative flex flex-col p-3 rounded-xl border-2 border-[#00685f] bg-[#00685f]/5 cursor-pointer transition-all";
            providerCard.className = "relative flex flex-col p-3 rounded-xl border-2 border-slate-200 bg-white cursor-pointer transition-all";
            btnText.textContent = "Tạo tài khoản Người chơi";
        } else {
            providerCard.querySelector("input").checked = true;
            providerCard.className = "relative flex flex-col p-3 rounded-xl border-2 border-[#00685f] bg-[#00685f]/5 cursor-pointer transition-all";
            playerCard.className = "relative flex flex-col p-3 rounded-xl border-2 border-slate-200 bg-white cursor-pointer transition-all";
            btnText.textContent = "Đăng ký làm Đối tác Chủ sân";
        }
    }

    function togglePasswordVisibility(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector(".material-symbols-outlined");
        if (input.type === "password") {
            input.type = "text";
            icon.textContent = "visibility_off";
        } else {
            input.type = "password";
            icon.textContent = "visibility";
        }
    }

    // Submit Login
    document.getElementById("form-login").addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnLoginSubmit");
        const email = document.getElementById("login-account").value.trim();
        const password = document.getElementById("login-password").value;

        btn.disabled = true;
        try {
            const res = await callApi("/api/auth/login", {
                method: "POST",
                data: { email, password }
            });

            AuthManager.setSession(res.token, {
                id: res.userId,
                fullName: res.fullName,
                email: res.email,
                role: res.role
            });

            Swal.fire({
                icon: "success",
                title: "Đăng nhập thành công!",
                text: `Xin chào ${res.fullName} (${res.role})`,
                timer: 1500,
                showConfirmButton: false
            });

            const returnUrl = new URLSearchParams(window.location.search).get("returnUrl");
            setTimeout(() => {
                if (returnUrl) window.location.href = returnUrl;
                else if (res.role === "Admin") window.location.href = "/Admin/Dashboard";
                else if (res.role === "Provider") window.location.href = "/Provider/Facilities";
                else window.location.href = "/";
            }, 1200);

        } catch (err) {
            Swal.fire({ icon: "error", title: "Thất bại", text: err.message, confirmButtonColor: "#00685f" });
            btn.disabled = false;
        }
    });

    // Submit Register
    document.getElementById("form-register").addEventListener("submit", async function (e) {
        e.preventDefault();
        const role = document.querySelector("input[name='reg_role']:checked").value;
        const fullName = document.getElementById("reg-fullname").value.trim();
        const email = document.getElementById("reg-email").value.trim();
        const phoneNumber = document.getElementById("reg-phone").value.trim();
        const password = document.getElementById("reg-password").value;

        try {
            await callApi("/api/auth/register", {
                method: "POST",
                data: { fullName, email, phoneNumber, password, role }
            });

            Swal.fire({
                icon: "success",
                title: "Đăng ký thành công!",
                text: "Tài khoản của bạn đã được tạo. Vui lòng đăng nhập.",
                confirmButtonColor: "#00685f"
            });
            switchAuthTab("login");
            document.getElementById("login-account").value = email;
        } catch (err) {
            Swal.fire({ icon: "error", title: "Lỗi đăng ký", text: err.message, confirmButtonColor: "#00685f" });
        }
    });

    // Check query params if #register
    document.addEventListener("DOMContentLoaded", function () {
        if (window.location.pathname.includes("Register") || window.location.hash === "#register") {
            switchAuthTab("register");
        }
    });
</script>
}
