<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtSide System Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Geist', 'Inter', 'system-ui', 'sans-serif'] },
                    colors: { primary: '#06525c', surface: '#f6f8f8' }
                }
            }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site-api.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen flex antialiased">
    <!-- Sidebar quản trị -->
    <aside class="w-60 bg-[#0f1f1d] text-white flex flex-col justify-between p-5 shrink-0 fixed h-full z-40">
        <div>
            <div class="flex items-center gap-2.5 px-2 mb-8">
                <span class="w-8 h-8 rounded-lg bg-[#06525c] flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px] text-[#6df5e1]">sports_tennis</span>
                </span>
                <div class="leading-tight">
                    <span class="font-extrabold text-[15px] block">CourtSide</span>
                    <span class="text-[10px] uppercase tracking-[0.12em] font-semibold text-[#8a9895]">Quản trị hệ thống</span>
                </div>
            </div>

            <p class="cs-eyebrow px-3 mb-2 text-[#5f6f6b]">Quản lý</p>
            <nav class="space-y-0.5">
                <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-semibold text-[#b9c7c3] hover:bg-white/5 hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[19px]">analytics</span>
                    <span>Tổng quan & lợi nhuận</span>
                </a>
                <a href="/Admin/Facilities" class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-semibold text-[#b9c7c3] hover:bg-white/5 hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[19px]">fact_check</span>
                    <span>Kiểm duyệt cơ sở</span>
                </a>
                <a href="/Admin/Users" class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-semibold text-[#b9c7c3] hover:bg-white/5 hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[19px]">manage_accounts</span>
                    <span>Người dùng</span>
                </a>
                <a href="/Admin/Topups" class="flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-semibold text-[#b9c7c3] hover:bg-white/5 hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[19px]">account_balance</span>
                    <span>Đối soát chuyển khoản</span>
                </a>
            </nav>
        </div>

        <div class="pt-5 border-t border-white/10 space-y-3">
            <div class="flex items-center gap-3 px-1">
                <div class="w-9 h-9 rounded-full bg-white/10 text-[#6df5e1] font-bold flex items-center justify-center text-xs">AD</div>
                <div class="overflow-hidden leading-tight">
                    <p id="adminName" class="text-[13px] font-semibold text-white truncate">Administrator</p>
                    <p id="adminEmail" class="text-[11px] text-[#8a9895] truncate">admin@courtside.vn</p>
                </div>
            </div>
            <a href="/" class="flex items-center gap-2 px-2 text-[12px] font-semibold text-[#8a9895] hover:text-white transition-colors">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Về trang chủ</span>
            </a>
            <button onclick="AuthManager.logout()" class="cs-btn cs-btn-block bg-white/5 hover:bg-white/10 text-[#f5b5ae] text-[12px] h-9">
                <span class="material-symbols-outlined text-[16px]">logout</span>
                <span>Đăng xuất</span>
            </button>
        </div>
    </aside>

    <div class="flex-grow pl-60 flex flex-col min-h-screen">
        <header class="h-16 bg-white/90 backdrop-blur-md border-b border-[#e2e8e6] px-8 flex items-center justify-between sticky top-0 z-30">
            <h1 class="text-[15px] font-bold text-[#0f1f1d]">@ViewData["Title"]</h1>
            <span class="cs-badge cs-badge-success">Phiên quản trị</span>
        </header>

        <main class="p-8 flex-grow">
            @RenderBody()
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Guard: chỉ Admin mới được vào
            if (AuthManager.requireAuth(["Admin"])) {
                const user = AuthManager.getUser();
                if (user) {
                    document.getElementById("adminName").textContent = user.fullName || "Admin";
                    document.getElementById("adminEmail").textContent = user.email || "";
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
