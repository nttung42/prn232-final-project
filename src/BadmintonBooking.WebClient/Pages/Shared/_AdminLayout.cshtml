<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtSide System Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        admin: '#0b1c30',
                        primary: '#00685f',
                        surface: '#f8f9ff'
                    }
                }
            }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site-api.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#f8f9ff] font-sans text-[#0b1c30] min-h-screen flex antialiased">
    <!-- Admin Left Sidebar -->
    <aside class="w-64 bg-[#0b1c30] text-white flex flex-col justify-between p-6 shrink-0 fixed h-full z-40">
        <div>
            <div class="flex items-center gap-2 mb-8">
                <span class="material-symbols-outlined text-[28px] text-[#6df5e1]">sports_tennis</span>
                <div>
                    <span class="font-bold text-lg text-white block leading-tight">CourtSide</span>
                    <span class="text-[10px] uppercase tracking-widest font-semibold text-slate-400">System Administrator</span>
                </div>
            </div>

            <nav class="space-y-1">
                <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-800 hover:text-white transition-all">
                    <span class="material-symbols-outlined text-[20px]">analytics</span>
                    <span>Thống kê Dashboard</span>
                </a>
                <a href="/Admin/Facilities" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-800 hover:text-white transition-all">
                    <span class="material-symbols-outlined text-[20px]">fact_check</span>
                    <span>Kiểm duyệt Cơ sở</span>
                </a>
                <a href="/Admin/Users" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-800 hover:text-white transition-all">
                    <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
                    <span>Quản lý Người dùng</span>
                </a>
                <a href="/Admin/Topups" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-800 hover:text-white transition-all">
                    <span class="material-symbols-outlined text-[20px]">account_balance_wallet</span>
                    <span>Đối soát Nạp ví</span>
                </a>
            </nav>
        </div>

        <div class="pt-6 border-t border-slate-800 space-y-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-slate-800 text-[#6df5e1] font-bold flex items-center justify-center text-sm">
                    AD
                </div>
                <div class="overflow-hidden">
                    <p id="adminName" class="text-xs font-bold text-white truncate">Administrator</p>
                    <p id="adminEmail" class="text-[11px] text-slate-400 truncate">admin@courtside.vn</p>
                </div>
            </div>
            <a href="/" class="flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition-colors py-1">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Về trang chủ</span>
            </a>
            <button onclick="AuthManager.logout()" class="w-full flex items-center justify-center gap-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 text-xs font-bold py-2 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">logout</span>
                <span>Đăng xuất</span>
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-grow pl-64 flex flex-col min-h-screen">
        <header class="h-16 bg-white/80 backdrop-blur-md border-b border-slate-200 px-8 flex items-center justify-between sticky top-0 z-30">
            <h1 class="text-lg font-bold text-slate-800">@ViewData["Title"]</h1>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Admin Session Active
                </span>
            </div>
        </header>

        <main class="p-8 flex-grow">
            @RenderBody()
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Guard: chỉ Admin mới được vào
            if (AuthManager.requireAuth(["Admin"])) {
                const user = AuthManager.getUser();
                if (user) {
                    document.getElementById("adminName").textContent = user.fullName || "Admin";
                    document.getElementById("adminEmail").textContent = user.email || "";
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

