<header class="fixed top-0 inset-x-0 z-50 bg-white/85 backdrop-blur-md border-b border-[#e2e8e6]">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-6">
        <div class="flex items-center gap-8 min-w-0">
            <a href="/" class="flex items-center gap-2 font-extrabold text-[17px] tracking-tight text-[#0f1f1d] shrink-0">
                <span class="w-8 h-8 rounded-lg bg-[#06525c] text-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">sports_tennis</span>
                </span>
                <span>CourtSide</span>
            </a>
            <nav class="hidden md:flex items-center gap-1">
                <a href="/" class="text-[13px] font-semibold text-[#5b6b68] hover:text-[#0f1f1d] hover:bg-[#f1f5f4] px-3 py-2 rounded-lg transition-colors">Trang chủ</a>
                <a href="/Player/Facilities" class="text-[13px] font-semibold text-[#5b6b68] hover:text-[#0f1f1d] hover:bg-[#f1f5f4] px-3 py-2 rounded-lg transition-colors">Danh sách sân</a>
                <a href="/Player/MyBookings" class="text-[13px] font-semibold text-[#5b6b68] hover:text-[#0f1f1d] hover:bg-[#f1f5f4] px-3 py-2 rounded-lg transition-colors">Lịch đặt của tôi</a>
                <a href="/Player/Wallet" class="text-[13px] font-semibold text-[#5b6b68] hover:text-[#0f1f1d] hover:bg-[#f1f5f4] px-3 py-2 rounded-lg transition-colors">Ví CourtSide</a>
            </nav>
        </div>

        <div class="flex items-center gap-3">
            <div class="relative hidden lg:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#8a9895] text-[18px]">search</span>
                <input id="quickSearchInput" type="text" placeholder="Tìm kiếm sân..."
                       class="cs-input pl-10 w-60 h-9 rounded-full bg-[#f1f5f4] border-transparent focus:bg-white" />
            </div>

            <div id="navGuestBox" class="flex items-center gap-2">
                <a href="/Auth/Login" class="cs-btn cs-btn-ghost cs-btn-sm">Đăng nhập</a>
                <a href="/Auth/Register" class="cs-btn cs-btn-primary cs-btn-sm">Đăng ký</a>
            </div>

            <div id="navUserBox" class="hidden items-center gap-3">
                <div class="flex flex-col text-right leading-tight">
                    <span id="navUserName" class="text-[13px] font-bold text-[#0f1f1d]">User</span>
                    <span id="navUserRoleBadge" class="text-[11px] font-semibold text-[#06525c]">Player</span>
                </div>

                <a id="navPortalLink" href="#" class="hidden cs-btn cs-btn-secondary cs-btn-sm" title="Trang quản trị">
                    <span class="material-symbols-outlined text-[18px]">dashboard</span>
                </a>

                <button onclick="AuthManager.logout()" class="cs-btn cs-btn-ghost cs-btn-sm" title="Đăng xuất">
                    <span class="material-symbols-outlined text-[18px]">logout</span>
                </button>
            </div>
        </div>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const user = AuthManager.getUser();
        const guestBox = document.getElementById("navGuestBox");
        const userBox = document.getElementById("navUserBox");
        const portalLink = document.getElementById("navPortalLink");

        if (user && AuthManager.isAuthenticated()) {
            if (guestBox) guestBox.classList.add("hidden");
            if (userBox) {
                userBox.classList.remove("hidden");
                userBox.classList.add("flex");
                document.getElementById("navUserName").textContent = user.fullName || user.email;
                document.getElementById("navUserRoleBadge").textContent = user.role;

                if (user.role === "Provider") {
                    portalLink.href = "/Provider/Facilities";
                    portalLink.classList.remove("hidden");
                } else if (user.role === "Admin") {
                    portalLink.href = "/Admin/Dashboard";
                    portalLink.classList.remove("hidden");
                }
            }
        }
    });
</script>
