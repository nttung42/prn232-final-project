<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtSide Provider Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        primary: '#00685f',
                        'primary-container': '#008378',
                        surface: '#f8f9ff',
                        'on-surface': '#0b1c30'
                    }
                }
            }
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site-api.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#f8f9ff] font-sans text-[#0b1c30] min-h-screen flex antialiased">
    <!-- Left Sidebar -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col justify-between p-6 shrink-0 fixed h-full z-40">
        <div>
            <div class="flex items-center gap-2 mb-8">
                <span class="material-symbols-outlined text-[28px] text-[#00685f]">sports_tennis</span>
                <div>
                    <span class="font-bold text-lg text-[#00685f] block leading-tight">CourtSide</span>
                    <span class="text-[10px] uppercase tracking-widest font-semibold text-slate-400">Chủ sân / Provider</span>
                </div>
            </div>

            <nav class="space-y-1">
                <a href="/Provider/Facilities" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#00685f] transition-all">
                    <span class="material-symbols-outlined text-[20px]">apartment</span>
                    <span>Cơ sở của tôi</span>
                </a>
                <a href="/Provider/CourtsAndSlots" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#00685f] transition-all">
                    <span class="material-symbols-outlined text-[20px]">stadium</span>
                    <span>Sân & Khung giờ</span>
                </a>
                <a href="/Provider/Bookings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 hover:text-[#00685f] transition-all">
                    <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                    <span>Quản lý Đơn đặt</span>
                </a>
            </nav>
        </div>

        <div class="pt-6 border-t border-slate-100 space-y-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-[#00685f]/10 text-[#00685f] font-bold flex items-center justify-center text-sm">
                    PR
                </div>
                <div class="overflow-hidden">
                    <p id="providerName" class="text-xs font-bold text-slate-800 truncate">Provider</p>
                    <p id="providerEmail" class="text-[11px] text-slate-400 truncate">provider@courtside.vn</p>
                </div>
            </div>
            <a href="/" class="flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-[#00685f] transition-colors py-1">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Về trang người chơi</span>
            </a>
            <button onclick="AuthManager.logout()" class="w-full flex items-center justify-center gap-2 bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold py-2 rounded-xl transition-colors">
                <span class="material-symbols-outlined text-[16px]">logout</span>
                <span>Đăng xuất</span>
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-grow pl-64 flex flex-col min-h-screen">
        <header class="h-16 bg-white/80 backdrop-blur-md border-b border-slate-200 px-8 flex items-center justify-between sticky top-0 z-30">
            <h1 class="text-lg font-bold text-slate-800">@ViewData["Title"]</h1>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    API Connected
                </span>
            </div>
        </header>

        <main class="p-8 flex-grow">
            @RenderBody()
        </main>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Guard: chỉ Provider và Admin mới được vào
            if (AuthManager.requireAuth(["Provider", "Admin"])) {
                const user = AuthManager.getUser();
                if (user) {
                    document.getElementById("providerName").textContent = user.fullName || "Provider";
                    document.getElementById("providerEmail").textContent = user.email || "";
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

