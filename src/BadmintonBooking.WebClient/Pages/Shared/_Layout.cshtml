<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourtSide Badminton Platform</title>

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- Tailwind CSS CDN & Config từ Stitch CourtSide -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#00685f',
                        'primary-container': '#008378',
                        'primary-light': '#89f5e7',
                        secondary: '#006b5f',
                        'secondary-container': '#6df5e1',
                        surface: '#f8f9ff',
                        'surface-container-lowest': '#ffffff',
                        'surface-container-low': '#eff4ff',
                        'surface-container-high': '#dce9ff',
                        'on-surface': '#0b1c30',
                        'on-surface-variant': '#3d4947',
                        tertiary: '#924628',
                        'tertiary-container': '#b05e3d'
                    }
                }
            }
        };
    </script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Base API Script -->
    <script src="~/js/site-api.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#f8f9ff] font-sans text-[#0b1c30] min-h-screen flex flex-col antialiased">
    @await Html.PartialAsync("_Header")

    <main class="flex-grow pt-20">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
