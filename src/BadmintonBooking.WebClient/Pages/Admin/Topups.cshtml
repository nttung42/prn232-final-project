@page
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đối soát chuyển khoản";
}

<div class="space-y-6">
    <div class="cs-card cs-card-pad flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="cs-title text-xl">Đối soát chuyển khoản</h2>
            <p class="text-xs text-slate-500">Đối chiếu sao kê ngân hàng (tài khoản MB nhận tiền) theo <b>mã chuyển khoản</b>, rồi xác nhận. Nạp ví và đơn đặt sân đều được xử lý tại đây.</p>
        </div>
        <button onclick="reload()" class="cs-btn cs-btn-secondary cs-btn-sm">Làm mới</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="cs-card cs-card-pad">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Phí nền tảng thu được</div>
            <div id="sumFee" class="text-2xl font-black text-emerald-700 mt-2">—</div>
            <div class="text-[11px] text-slate-400 mt-1">5% trên giá sân các đơn đã duyệt</div>
        </div>
        <div class="cs-card cs-card-pad">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Doanh thu gộp đơn đã duyệt</div>
            <div id="sumGross" class="text-2xl font-black tracking-tight text-slate-900 mt-2">—</div>
            <div class="text-[11px] text-slate-400 mt-1">Tổng giá sân (không tính đơn đã hoàn)</div>
        </div>
        <div class="cs-card cs-card-pad">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Chủ sân nhận</div>
            <div id="sumProvider" class="text-2xl font-black tracking-tight text-slate-900 mt-2">—</div>
            <div class="text-[11px] text-slate-400 mt-1">Sau khi trừ phí nền tảng</div>
        </div>
    </div>

    <div class="bg-amber-50 border border-amber-200 text-amber-800 text-xs p-4 rounded-2xl">
        Chỉ xác nhận khi thấy đúng <b>số tiền</b> và <b>nội dung chuyển khoản</b> (mã CSIDE...) trong sao kê ngân hàng.
    </div>

    <div class="flex gap-2">
        <button id="tabPending" onclick="showTab('pending')" class="cs-btn cs-btn-primary cs-btn-sm">Chờ đối soát</button>
        <button id="tabHistory" onclick="showTab('history')" class="cs-btn cs-btn-secondary cs-btn-sm">Lịch sử đối soát</button>
    </div>

    <div class="cs-card overflow-hidden">
        <div class="cs-table-wrap">
            <table class="cs-table">
                <thead id="tableHead"></thead>
                <tbody id="reviewTbody" class="divide-y divide-slate-100">
                    <tr><td class="py-12 text-center text-slate-400">Đang tải...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const fmtVnd = n => new Intl.NumberFormat("vi-VN").format(Math.round(Number(n) || 0)) + "đ";
    let currentTab = "pending";

    function showTab(tab) {
        currentTab = tab;
        document.getElementById("tabPending").className = `cs-btn cs-btn-sm ${tab === "pending" ? "cs-btn-primary" : "cs-btn-secondary"}`;
        document.getElementById("tabHistory").className = `cs-btn cs-btn-sm ${tab === "history" ? "cs-btn-primary" : "cs-btn-secondary"}`;
        reload();
    }

    function reload() {
        loadSummary();
        currentTab === "pending" ? loadPending() : loadHistory();
    }

    async function loadSummary() {
        try {
            const s = await callApi("/api/payments/summary");
            document.getElementById("sumFee").textContent = fmtVnd(s.platformFee);
            document.getElementById("sumGross").textContent = fmtVnd(s.grossAmount);
            document.getElementById("sumProvider").textContent = fmtVnd(s.providerAmount);
        } catch (e) { /* giữ nguyên */ }
    }

    function setHead(cols) {
        document.getElementById("tableHead").innerHTML =
            `<tr class="">${cols.map(c => `<th class="py-4 px-6 ${c.right ? 'text-right' : ''}">${c.label}</th>`).join("")}</tr>`;
    }

    async function loadPending() {
        const tbody = document.getElementById("reviewTbody");
        setHead([{label:"Mã chuyển khoản"},{label:"Loại"},{label:"Người chuyển / Cơ sở"},{label:"Tạo lúc"},{label:"Số tiền",right:true},{label:"Thao tác",right:true}]);
        try {
            const items = await callApi("/api/payments/review");
            if (!items.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-slate-400 text-xs">Không có yêu cầu nào đang chờ xác nhận.</td></tr>`;
                return;
            }
            tbody.innerHTML = items.map(p => {
                const isTopUp = p.purpose === "TopUp";
                const held = p.status === "Held";
                const type = isTopUp ? "Nạp ví" : (held ? `Đặt sân #${p.bookingId} · đã trừ ví` : `Đặt sân #${p.bookingId}`);
                const confirmLabel = isTopUp ? "Đã nhận tiền" : (held ? "Duyệt đơn" : "Đã nhận tiền");
                const reject = isTopUp ? "" : `<button onclick="rejectPayment('${escapeHtml(p.code)}')" class="cs-btn cs-btn-danger cs-btn-sm ml-1">Từ chối</button>`;
                return `
                <tr class="hover:bg-slate-50/70">
                    <td class="py-4 px-6 font-mono font-bold text-slate-800">${escapeHtml(p.code)}</td>
                    <td class="py-4 px-6 text-slate-700">${type}</td>
                    <td class="py-4 px-6"><div class="font-bold text-slate-800">${escapeHtml(p.playerName || "")}</div><div class="text-slate-500">${escapeHtml(p.facilityName || "")}</div></td>
                    <td class="py-4 px-6 text-slate-600">${new Date(p.createdAt).toLocaleString("vi-VN")}</td>
                    <td class="py-4 px-6 text-right font-bold text-emerald-700">${fmtVnd(p.amount)}</td>
                    <td class="py-4 px-6 text-right whitespace-nowrap">
                        <button onclick="confirmPayment('${escapeHtml(p.code)}')" class="cs-btn cs-btn-success cs-btn-sm">${confirmLabel}</button>${reject}
                    </td>
                </tr>`;
            }).join("");
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-rose-500 text-xs">Lỗi: ${escapeHtml(err.message)}</td></tr>`;
        }
    }

    async function loadHistory() {
        const tbody = document.getElementById("reviewTbody");
        setHead([{label:"Mã"},{label:"Đơn"},{label:"Khách"},{label:"Xác nhận bởi"},{label:"Thời gian"},{label:"Số tiền",right:true},{label:"Phí nền tảng",right:true},{label:"Trạng thái"}]);
        try {
            const items = await callApi("/api/payments/history");
            if (!items.length) {
                tbody.innerHTML = `<tr><td colspan="8" class="py-12 text-center text-slate-400 text-xs">Chưa có giao dịch nào được xử lý.</td></tr>`;
                return;
            }
            tbody.innerHTML = items.map(h => {
                const reversed = !!h.reversedAt;
                const status = reversed
                    ? `<span class="cs-badge cs-badge-danger">Đã hoàn</span>`
                    : `<span class="cs-badge cs-badge-success">Đã xác nhận</span>`;
                return `
                <tr class="hover:bg-slate-50/70">
                    <td class="py-4 px-6 font-mono text-slate-700">${escapeHtml(h.code)}</td>
                    <td class="py-4 px-6 text-slate-700">${h.purpose === "TopUp" ? "Nạp ví" : "#BK-" + h.bookingId}<div class="text-slate-500">${escapeHtml(h.facilityName || "")}</div></td>
                    <td class="py-4 px-6 text-slate-700">${escapeHtml(h.playerName || "")}</td>
                    <td class="py-4 px-6 font-bold text-slate-800">${escapeHtml(h.confirmedByName || "—")}</td>
                    <td class="py-4 px-6 text-slate-600">${h.confirmedAt ? new Date(h.confirmedAt).toLocaleString("vi-VN") : "—"}</td>
                    <td class="py-4 px-6 text-right font-bold">${fmtVnd(h.amount)}</td>
                    <td class="py-4 px-6 text-right text-emerald-700">${reversed ? "0đ" : fmtVnd(h.platformFee)}</td>
                    <td class="py-4 px-6">${status}</td>
                </tr>`;
            }).join("");
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-rose-500 text-xs">Lỗi: ${escapeHtml(err.message)}</td></tr>`;
        }
    }

    async function confirmPayment(code) {
        const ok = await Swal.fire({
            icon: "question",
            title: "Xác nhận đã nhận tiền?",
            text: `Mã ${code}. Chỉ xác nhận khi đã đối chiếu được số tiền và nội dung chuyển khoản.`,
            showCancelButton: true,
            confirmButtonColor: "#06525c",
            confirmButtonText: "Xác nhận",
            cancelButtonText: "Hủy"
        });
        if (!ok.isConfirmed) return;
        try {
            await callApi(`/api/payments/${encodeURIComponent(code)}/confirm`, { method: "POST" });
            Swal.fire({ icon: "success", title: "Đã xác nhận", timer: 1200, showConfirmButton: false });
            reload();
        } catch (err) {
            Swal.fire({ icon: "error", title: "Không thể xác nhận", text: err.message, confirmButtonColor: "#06525c" });
        }
    }

    async function rejectPayment(code) {
        const ok = await Swal.fire({
            icon: "warning",
            title: "Từ chối đơn?",
            text: "Đơn sẽ bị hủy. Nếu khách đã trừ ví, số tiền sẽ được hoàn về ví.",
            showCancelButton: true,
            confirmButtonColor: "#ba1a1a",
            confirmButtonText: "Từ chối",
            cancelButtonText: "Quay lại"
        });
        if (!ok.isConfirmed) return;
        try {
            await callApi(`/api/payments/${encodeURIComponent(code)}/reject`, { method: "POST" });
            Swal.fire({ icon: "success", title: "Đã từ chối đơn", timer: 1200, showConfirmButton: false });
            reload();
        } catch (err) {
            Swal.fire({ icon: "error", title: "Không thể từ chối", text: err.message, confirmButtonColor: "#06525c" });
        }
    }

    document.addEventListener("DOMContentLoaded", () => reload());
</script>
}
