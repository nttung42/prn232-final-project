@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ - Hệ Thống Đặt Sân Cầu Lông Đa Nhà Cung Cấp";
}

<div class="flex flex-col w-full">
    <!-- Hero Banner Section -->
    <section class="bg-[#0b2e2a] text-white">
        <div class="max-w-6xl mx-auto px-6 py-24 md:py-28 flex flex-col items-start gap-6">
            <span class="cs-eyebrow !text-[#6df5e1]">Nền tảng đặt sân cầu lông CourtSide</span>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight max-w-2xl">Đặt sân cầu lông nhanh, rõ ràng, đúng giờ.</h1>
            <p class="text-base md:text-lg text-white/70 max-w-xl leading-relaxed">Xem ma trận sân theo thời gian thực, chọn ca và thanh toán ngay trên web. Chủ sân xác nhận đơn và theo dõi doanh thu tại một nơi.</p>
            <div class="flex flex-wrap items-center gap-3 pt-2">
                <a href="/Player/Facilities" class="cs-btn cs-btn-primary !bg-[#6df5e1] !text-[#0b2e2a] hover:!bg-[#4fe6cf] !h-11 !px-6">Tìm sân ngay</a>
                <a href="#featured-courts" class="cs-btn !h-11 !px-6 !bg-transparent !text-white !border !border-white/25 hover:!bg-white/10">Xem cơ sở đã duyệt</a>
            </div>
        </div>
    </section>

    <!-- Quick Stats & Service Highlights Section -->
    <section class="max-w-6xl w-full mx-auto px-6 -mt-10 relative z-30">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-white p-6 rounded-2xl cs-card cs-card-pad flex flex-col gap-2">
                <div class="w-12 h-12 rounded-xl bg-[#06525c]/10 flex items-center justify-center text-[#06525c] mb-1">
                    <span class="material-symbols-outlined text-[24px]">sports_tennis</span>
                </div>
                <span class="text-2xl text-slate-800 font-extrabold" id="statFacilities">Đang tải...</span>
                <span class="text-xs text-slate-500">Cơ sở đã được quản trị viên duyệt</span>
            </div>

            <div class="bg-white p-6 rounded-2xl cs-card cs-card-pad flex flex-col gap-2">
                <div class="w-12 h-12 rounded-xl bg-teal-50 flex items-center justify-center text-teal-600 mb-1">
                    <span class="material-symbols-outlined text-[24px]">group</span>
                </div>
                <span class="text-2xl text-slate-800 font-extrabold">Đặt sân online</span>
                <span class="text-xs text-slate-500">Chọn sân, chọn ca và thanh toán ngay trên web</span>
            </div>

            <div class="bg-white p-6 rounded-2xl cs-card cs-card-pad flex flex-col gap-2">
                <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600 mb-1">
                    <span class="material-symbols-outlined text-[24px]">shopping_bag</span>
                </div>
                <span class="text-2xl text-slate-800 font-extrabold">Thanh toán VietQR</span>
                <span class="text-xs text-slate-500">Chuyển khoản qua mã QR, chủ sân xác nhận đơn</span>
            </div>

            <div class="bg-white p-6 rounded-2xl cs-card cs-card-pad flex flex-col gap-2">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 mb-1">
                    <span class="material-symbols-outlined text-[24px]">handshake</span>
                </div>
                <span class="text-2xl text-slate-800 font-extrabold">Ví CourtSide</span>
                <span class="text-xs text-slate-500">Nạp tiền, thanh toán đơn và hoàn tiền khi hủy</span>
            </div>
        </div>
    </section>

    <!-- Featured Courts Grid Section -->
    <section class="max-w-7xl w-full mx-auto px-6 py-20" id="featured-courts">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
            <div>
                <span class="text-xs text-[#06525c] uppercase font-bold tracking-widest block mb-2">Hệ thống cơ sở</span>
                <h2 class="text-3xl text-slate-800 font-black">Các cụm sân nổi bật đã kiểm duyệt</h2>
            </div>
            <div class="flex items-center gap-3">
                <a href="/Player/Facilities" class="bg-[#06525c] hover:bg-[#053f47] text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center gap-1 shadow-md">
                    <span>Xem tất cả cơ sở</span>
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
            </div>
        </div>

        <!-- 3-Column Grid Dynamically Loaded -->
        <div id="homeFeaturedList" class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="col-span-full py-12 text-center text-slate-400">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-[#06525c] border-t-transparent"></div>
                <p class="text-sm mt-3">Đang tải danh sách sân nổi bật...</p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", async function () {
        const container = document.getElementById("homeFeaturedList");
        try {
            // Gọi API OData lọc các cơ sở có Status = Approved
            const query = buildODataQuery({
                filter: "Status eq 'Approved'",
                orderby: "CreatedAt desc",
                top: 6
            });

            const facilities = await callApi(`/api/facilities${query}`);

            // Số cơ sở đã duyệt thật, không dùng con số cố định
            callApi("/api/facilities").then(all => {
                document.getElementById("statFacilities").textContent = `${all.length} Cụm sân`;
            }).catch(() => {
                document.getElementById("statFacilities").textContent = "Cụm sân đã duyệt";
            });

            if (!facilities || facilities.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full py-12 text-center bg-white rounded-2xl border border-dashed border-slate-200">
                        <span class="material-symbols-outlined text-slate-300 text-[48px]">stadium</span>
                        <p class="text-slate-500 font-semibold mt-2">Hiện chưa có cụm sân nào được phê duyệt.</p>
                        <a href="/Auth/Register" class="text-xs text-[#06525c] font-bold mt-2 inline-block">Đăng ký làm chủ sân (Provider) để đăng sân ngay</a>
                    </div>
                `;
                return;
            }

            container.innerHTML = facilities.map(f => `
                <div class="bg-white rounded-2xl overflow-hidden shadow-lg shadow-slate-200/50 flex flex-col group transition-all hover:-translate-y-1.5 border border-slate-100">
                    <div class="relative h-60 w-full bg-cover bg-center overflow-hidden bg-slate-200" 
                         style="background-image: url('${f.imageUrl || 'https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?q=80&w=600&auto=format&fit=crop'}')">
                        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-slate-800 flex items-center gap-1 shadow-sm">
                            <span class="material-symbols-outlined text-[#06525c] text-[14px]">location_on</span>
                            <span>${escapeHtml(f.district)}</span>
                        </div>
                        <div class="absolute top-4 right-4 bg-[#06525c] text-white px-3 py-1 rounded-full text-xs font-bold shadow-md">
                            Đã duyệt
                        </div>
                    </div>
                    <div class="p-6 flex flex-col flex-grow justify-between gap-4">
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <h3 class="font-bold text-lg text-slate-800 group-hover:text-[#06525c] transition-colors line-clamp-1">${escapeHtml(f.name)}</h3>
                                <div class="flex items-center gap-1 text-orange-500 font-bold text-sm">
                                    <span class="material-symbols-outlined text-[16px]">star</span>
                                    <span>Chưa có đánh giá</span>
                                </div>
                            </div>
                            <p class="text-xs text-slate-500 flex items-center gap-1 line-clamp-1">
                                <span class="material-symbols-outlined text-[14px]">pin_drop</span>
                                <span>${escapeHtml(f.address)}, ${escapeHtml(f.district)}</span>
                            </p>
                            <p class="text-xs text-slate-500 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">schedule</span>
                                <span>Giờ mở cửa: ${formatTime(f.openTime)} - ${formatTime(f.closeTime)}</span>
                            </p>
                        </div>
                        <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                            <div>
                                <span class="text-[11px] text-slate-400 block">Liên hệ</span>
                                <span class="text-sm font-bold text-slate-700">${escapeHtml(f.phone)}</span>
                            </div>
                            <a href="/Player/FacilityDetail?id=${f.id}" class="bg-[#06525c] hover:bg-[#053f47] text-white px-4 py-2 rounded-xl font-bold text-xs shadow-md transition-all hover:scale-105 flex items-center gap-1">
                                <span>Đặt sân</span>
                                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                            </a>
                        </div>
                    </div>
                </div>
            `).join("");

        } catch (err) {
            console.error("Lỗi tải sân nổi bật:", err);
            container.innerHTML = `
                <div class="col-span-full py-12 text-center bg-rose-50 rounded-2xl border border-rose-100 text-rose-600">
                    <p class="text-sm font-semibold">Không thể kết nối đến Web API backend (${API_BASE_URL}).</p>
                    <p class="text-xs mt-1 text-slate-500">Hãy chắc chắn Web API đang chạy tại http://localhost:6789</p>
                </div>
            `;
        }
    });
</script>
}
