@page
@{
    Layout = "_ProviderLayout";
    ViewData["Title"] = "Quản lý Đơn đặt & Xuất báo cáo";
}

<div class="space-y-6">
    <!-- Top Action Toolbar with Content Negotiation Demo -->
    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-black text-slate-800">Quản lý Đơn đặt sân</h2>
            <p class="text-xs text-slate-500">Theo dõi khách hàng đặt sân và xuất báo cáo dữ liệu nhiều định dạng</p>
        </div>

        <!-- Content Negotiation Export Buttons (PRN232 Core Feature) -->
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mr-1">Xuất dữ liệu:</span>
            
            <button onclick="exportBookings('text/csv', 'bookings.csv')" 
                    class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-[16px]">csv</span>
                <span>Export CSV (Excel)</span>
            </button>

            <button onclick="exportBookings('application/xml', 'bookings.xml')" 
                    class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-[16px]">code</span>
                <span>Export XML</span>
            </button>

            <button onclick="exportBookings('application/json', 'bookings.json')" 
                    class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-[16px]">data_object</span>
                <span>Export JSON</span>
            </button>
        </div>
    </div>

    <!-- OData Filter Toolbar -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <div>
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-0.5">Trạng thái đơn</label>
                <select id="filterBookingStatus" onchange="loadBookings()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#00685f]">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Pending">Chờ duyệt (Pending)</option>
                    <option value="Confirmed">Đã duyệt (Confirmed)</option>
                    <option value="Completed">Hoàn tất (Completed)</option>
                    <option value="Cancelled">Đã hủy (Cancelled)</option>
                </select>
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase text-slate-400 mb-0.5">Ngày chơi (PlayDate)</label>
                <input type="date" id="filterPlayDate" onchange="loadBookings()" 
                       class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#00685f]" />
            </div>

            <button onclick="clearFilters()" class="text-xs font-bold text-slate-500 hover:text-slate-800 self-end py-1.5 px-2">
                Xóa bộ lọc
            </button>
        </div>

        <span id="bookingCount" class="text-xs text-slate-400 font-semibold">Đang tải...</span>
    </div>

    <!-- Bookings Data Table -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold uppercase tracking-wider text-[11px]">
                        <th class="py-4 px-6">Mã đơn</th>
                        <th class="py-4 px-6">Khách hàng</th>
                        <th class="py-4 px-6">Sân & Cơ sở</th>
                        <th class="py-4 px-6">Khung giờ</th>
                        <th class="py-4 px-6">Ngày chơi</th>
                        <th class="py-4 px-6">Doanh thu</th>
                        <th class="py-4 px-6">Trạng thái</th>
                        <th class="py-4 px-6 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody id="providerBookingsTbody" class="divide-y divide-slate-100">
                    <tr>
                        <td colspan="8" class="py-12 text-center text-slate-400">
                            <div class="inline-block animate-spin rounded-full h-6 w-6 border-2 border-[#00685f] border-t-transparent"></div>
                            <p class="mt-2">Đang tải danh sách đơn...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function loadBookings() {
        const tbody = document.getElementById("providerBookingsTbody");
        const countSpan = document.getElementById("bookingCount");
        const status = document.getElementById("filterBookingStatus").value;
        const playDate = document.getElementById("filterPlayDate").value;

        const filters = [];
        if (status) filters.push(`Status eq '${status}'`);
        if (playDate) filters.push(`PlayDate eq ${playDate}`);

        const queryStr = buildODataQuery({
            filter: filters.length > 0 ? filters.join(" and ") : null,
            orderby: "CreatedAt desc"
        });

        try {
            const bookings = await callApi(`/api/bookings${queryStr}`);
            countSpan.textContent = `Tổng cộng: ${bookings.length} đơn`;

            if (bookings.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="py-12 text-center text-slate-400 text-xs">Không có đơn đặt sân nào.</td></tr>`;
                return;
            }

            tbody.innerHTML = bookings.map(b => {
                let statusBadge = "";
                if (b.status === "Pending") statusBadge = `<span class="bg-amber-50 text-amber-700 border border-amber-200 px-2.5 py-1 rounded-full text-[10px] font-bold">Chờ duyệt</span>`;
                else if (b.status === "Confirmed") statusBadge = `<span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-full text-[10px] font-bold">Đã duyệt</span>`;
                else if (b.status === "Completed") statusBadge = `<span class="bg-blue-50 text-blue-700 border border-blue-200 px-2.5 py-1 rounded-full text-[10px] font-bold">Hoàn tất</span>`;
                else if (b.status === "Cancelled") statusBadge = `<span class="bg-rose-50 text-rose-700 border border-rose-200 px-2.5 py-1 rounded-full text-[10px] font-bold">Đã hủy</span>`;

                return `
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td class="py-4 px-6 font-mono font-bold text-slate-700">#BK-${b.id}</td>
                        <td class="py-4 px-6">
                            <div class="font-bold text-slate-800">${b.playerName || "Khách hàng"}</div>
                            <div class="text-[11px] text-slate-400">${b.playerPhone || ""}</div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="font-bold text-slate-800">${b.facilityName || "Cơ sở"}</div>
                            <div class="text-[11px] text-slate-400">${b.courtName || "Sân con"}</div>
                        </td>
                        <td class="py-4 px-6 font-medium text-slate-700">
                            ${formatTime(b.startTime)} - ${formatTime(b.endTime)}
                        </td>
                        <td class="py-4 px-6 font-medium text-slate-600">
                            ${formatDate(b.playDate)}
                        </td>
                        <td class="py-4 px-6 font-bold text-[#00685f]">
                            ${formatCurrency(b.totalPrice)}
                        </td>
                        <td class="py-4 px-6">
                            ${statusBadge}
                        </td>
                        <td class="py-4 px-6 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                ${b.status === "Pending" ? `
                                    <button onclick="updateStatus(${b.id}, 'Confirmed')" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-lg font-bold text-[11px] transition-colors">
                                        Duyệt
                                    </button>
                                ` : ""}
                                ${b.status === "Confirmed" ? `
                                    <button onclick="updateStatus(${b.id}, 'Completed')" class="bg-blue-50 hover:bg-blue-100 text-blue-700 px-2.5 py-1 rounded-lg font-bold text-[11px] transition-colors">
                                        Xong
                                    </button>
                                ` : ""}
                                ${b.status !== "Cancelled" && b.status !== "Completed" ? `
                                    <button onclick="updateStatus(${b.id}, 'Cancelled')" class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-2.5 py-1 rounded-lg font-bold text-[11px] transition-colors">
                                        Hủy
                                    </button>
                                ` : ""}
                            </div>
                        </td>
                    </tr>
                `;
            }).join("");

        } catch (err) {
            console.error("Lỗi:", err);
            tbody.innerHTML = `<tr><td colspan="8" class="py-6 text-center text-rose-500 text-xs">Lỗi: ${err.message}</td></tr>`;
        }
    }

    async function updateStatus(id, newStatus) {
        try {
            await callApi(`/api/bookings/${id}`, {
                method: "PUT",
                data: { status: newStatus, note: "Provider cập nhật qua Dashboard" }
            });
            Swal.fire({ icon: "success", title: "Cập nhật thành công!", timer: 1200, showConfirmButton: false });
            loadBookings();
        } catch (err) {
            Swal.fire({ icon: "error", title: "Lỗi", text: err.message, confirmButtonColor: "#00685f" });
        }
    }

    // Xuất dữ liệu qua HTTP Header Accept (Content Negotiation)
    async function exportBookings(acceptHeader, filename) {
        try {
            Swal.fire({
                title: "Đang xuất dữ liệu...",
                text: `Đang gửi yêu cầu với Header Accept: ${acceptHeader}`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const blob = await callApi("/api/bookings", {
                accept: acceptHeader,
                isBlob: true
            });

            triggerDownload(blob, filename);
            Swal.fire({
                icon: "success",
                title: "Xuất dữ liệu thành công!",
                text: `Tệp ${filename} đã được tải về máy của bạn.`,
                confirmButtonColor: "#00685f",
                timer: 2000
            });
        } catch (err) {
            Swal.fire({
                icon: "error",
                title: "Lỗi xuất dữ liệu",
                text: err.message,
                confirmButtonColor: "#00685f"
            });
        }
    }

    function clearFilters() {
        document.getElementById("filterBookingStatus").value = "";
        document.getElementById("filterPlayDate").value = "";
        loadBookings();
    }

    document.addEventListener("DOMContentLoaded", loadBookings);
</script>
}

